/*
=================================================================================
DATA EXPLORATION 
=================================================================================
PURPOSE:
    - TO CHECK THE TOTAL NUMBER OF ASSETS LISTED FROM 2014-2017
    - TO CHECK THE TOTAL NUMBER OF DAYS THE MARKET WAS OPENED FOR
    - TO CHECK THE DATE RANGE
    - TO CHECK FOR MISSING VALUES OR MISSING TRADING DAYS
    - TO CHECK THE MIN/MAX PRICE FOR EACH ASSSET FROM 2014-2017
    - TO CHECK IF ANY ASSET WAS NOT LISTED AT THE BEGINNING OF A YEAR
    - TO CHECK THE AVERAGE DAILY TRADING VOLUME PER ASSET

SQL FUNCTIONS USED:
    - COUNT, MIN, MAX, COALESCE, CAST, ROUND, AVG, OVER()
NOTE:
    DATA EXTRACTED HERE WOULD BE USED FOR SEVERAL DATA INTERPRETATION
=================================================================================
*/
-- TOTAL NUMBER OF ASSETS LSITED FROM 2014-2017
SELECT 
    COUNT(DISTINCT SYMBOL) AS NUMBER_OF_ASSETS
FROM SP.Stock_Prices_2014_2017;

-- TOTAL NUMBER OF TRADING DAYS BETWEEN 2014 AND 2017 
SELECT
    COUNT(DISTINCT TRADING_DATE) AS NUMBER_OF_TRADING_DAYS
FROM SP.Stock_Prices_2014_2017

-- GETTING THE FIRST AND LAST DAY OF TRADING FOR EACH YEAR
SELECT *
FROM SP.Stock_Prices_2014_2017
ORDER BY TRADING_DATE


-- TOTAL NUMBER OF ASSETS LISTED FOR EACH YEAR FILTERED BY THE FIRST/LAST DAY OF TRADING

-- TOTAL NUMBER OF ASSETS LISTED BY THE END OF 2014
SELECT
    COUNT(DISTINCT SYMBOL) AS NUMBER_OF_ASSETS2014
FROM SP.Stock_Prices_2014_2017
WHERE TRADING_DATE >= '2014-01-01' AND TRADING_DATE < '2015-01-01';


-- TOTAL NUMBER OF ASSETS LISTED BY THE END OF 2015
SELECT
    COUNT(DISTINCT SYMBOL) AS NUMBER_OF_ASSETS2015
FROM SP.Stock_Prices_2014_2017
WHERE TRADING_DATE >= '2015-01-01' AND TRADING_DATE < '2016-01-01';


-- TOTAL NUMBER OF ASSETS LISTED BY THE END OF 2016
SELECT
    COUNT(DISTINCT SYMBOL) AS NUMBER_OF_ASSETS2016
FROM SP.Stock_Prices_2014_2017
WHERE TRADING_DATE >= '2016-01-01' AND TRADING_DATE < '2017-01-01';


-- TOTAL NUMBER OF ASSETS LISTED BY THE END OF 2017
SELECT
    COUNT(DISTINCT SYMBOL) AS NUMBER_OF_ASSETS2017
FROM SP.Stock_Prices_2014_2017
WHERE TRADING_DATE >= '2017-01-01' AND TRADING_DATE < '2018-01-01';


-- DATE RANGE CHECK (NUMBER OF TRADING YEARS IN OUR DATA)
SELECT
    MIN(YEAR(TRADING_DATE)) AS FIRST_TRADING_DAY,
    MAX(YEAR(TRADING_DATE)) AS LAST_TRADING_DAY,
    MAX(YEAR(TRADING_DATE)) - MIN(YEAR(TRADING_DATE)) +1 AS TOTAL_TRADING_YEARS
FROM SP.Stock_Prices_2014_2017;
-- OR
SELECT 
    COUNT(DISTINCT YEAR(TRADING_DATE)) AS TOTAL_TRADING_YEARS
FROM SP.Stock_Prices_2014_2017;


-- MISSING VALUES (EXPLORING ALL THE COLUMNS FOR MISSING VALUES)

-- COLUMN 'SYMBOL'
SELECT *
FROM SP.Stock_Prices_2014_2017
WHERE SYMBOL IS NULL;

-- COLUMN 'TRADING_DATE'
SELECT *
FROM SP.Stock_Prices_2014_2017
WHERE TRADING_DATE IS NULL;

-- COLUMN 'OPEN_PRICE'
SELECT *
FROM SP.Stock_Prices_2014_2017
WHERE OPEN_PRICE IS NULL;

-- COLUMN 'DAY_HIGH'
SELECT *
FROM SP.Stock_Prices_2014_2017
WHERE DAY_HIGH IS NULL;

-- COLUMN 'DAY_LOW'
SELECT *
FROM SP.Stock_Prices_2014_2017
WHERE DAY_LOW IS NULL;

-- COLUMN 'CLOSE_PRICE'
SELECT *
FROM SP.Stock_Prices_2014_2017
WHERE CLOSE_PRICE IS NULL;

-- COLUMN 'VOLUME'
SELECT *
FROM SP.Stock_Prices_2014_2017
WHERE VOLUME IS NULL;



-- MIN/MAX PRICES FOR EACH ASSET IN A YEAR
-- YEAR 2014
SELECT
    SYMBOL,
    MIN(COALESCE(CAST(OPEN_PRICE AS FLOAT), 0)) AS LOWEST_OPENPRICE_2014,
    MAX(COALESCE(CAST(OPEN_PRICE AS FLOAT), 0)) AS HIGHEST_OPENPRICE_2014,
    MIN(CLOSE_PRICE) AS LOWEST_CLOSEPRICE_2014,
    MAX(CLOSE_PRICE) AS HIGHEST_CLOSEPRICE_2014
FROM SP.Stock_Prices_2014_2017
WHERE TRADING_DATE >= '2014-01-01' AND TRADING_DATE < '2015-01-01'
GROUP BY SYMBOL
ORDER BY SYMBOL;

-- YEAR 2015
SELECT
    SYMBOL,
    MIN(COALESCE(CAST(OPEN_PRICE AS FLOAT), 0)) AS LOWEST_OPENPRICE_2015,
    MAX(COALESCE(CAST(OPEN_PRICE AS FLOAT), 0)) AS HIGHEST_OPENPRICE_2015,
    MIN(CLOSE_PRICE) AS LOWEST_CLOSEPRICE_2015,
    MAX(CLOSE_PRICE) AS HIGHEST_CLOSEPRICE_2015
FROM SP.Stock_Prices_2014_2017
WHERE TRADING_DATE >= '2015-01-01' AND TRADING_DATE < '2016-01-01'
GROUP BY SYMBOL
ORDER BY SYMBOL;

-- YEAR 2016
SELECT
    SYMBOL,
    MIN(COALESCE(CAST(OPEN_PRICE AS FLOAT), 0)) AS LOWEST_OPENPRICE_2016,
    MAX(COALESCE(CAST(OPEN_PRICE AS FLOAT), 0)) AS HIGHEST_OPENPRICE_2016,
    MIN(CLOSE_PRICE) AS LOWEST_CLOSEPRICE_2016,
    MAX(CLOSE_PRICE) AS HIGHEST_CLOSEPRICE_2016
FROM SP.Stock_Prices_2014_2017
WHERE TRADING_DATE >= '2016-01-01' AND TRADING_DATE < '2017-01-01'
GROUP BY SYMBOL
ORDER BY SYMBOL;

-- YEAR 2017
SELECT
    SYMBOL,
    MIN(COALESCE(CAST(OPEN_PRICE AS FLOAT), 0)) AS LOWEST_OPENPRICE_2017,
    MAX(COALESCE(CAST(OPEN_PRICE AS FLOAT), 0)) AS HIGHEST_OPENPRICE_2017,
    MIN(CLOSE_PRICE) AS LOWEST_CLOSEPRICE_2017,
    MAX(CLOSE_PRICE) AS HIGHEST_CLOSEPRICE_2017
FROM SP.Stock_Prices_2014_2017
WHERE TRADING_DATE >= '2017-01-01' AND TRADING_DATE < '2018-01-01'
GROUP BY SYMBOL
ORDER BY SYMBOL


-- AVERAGE TRADING VOLUME (USING WINDOW FUNCTION)
SELECT
    SYMBOL,
    TRADING_DATE,
    OPEN_PRICE,
    CLOSE_PRICE,
    VOLUME,
    ROUND(AVG(CAST(VOLUME AS FLOAT)) OVER (PARTITION BY SYMBOL ORDER BY TRADING_DATE), 4) AS AVG_VOLUME
FROM SP.Stock_Prices_2014_2017

