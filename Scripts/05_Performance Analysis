/*
========================================================================================
PERFOMANCE ANALYSIS
========================================================================================
PURPOSE: TO CHECK
    - IF A GIVEN TRADING YEAR WAS PROFITABLE
    - WHICH ASSET HAD THE HIGHEST TOTAL RETURN FROM 2014 - 2017
    - WHICH YEAR HAD THE BEST AVERAGE MARKET PERFOMANCE
    - WHAT ARE THE TOP 10 PERFORMING ASSETS
    - WHICH ASSET HAD A DECLINING TREND
    - 
SQL FUNCTIONS USED:
    - CASE WHEN, CAST, COALESCE, ROUND

NOTE:
    THIS CALCULATIONS IS VALID FOR ASSETS LISTED AT THE BEGINNING OF EACH TRADING YEAR
========================================================================================
*/

-- WAS EACH YEAR A PROFITABLE YEAR FOR EACH ASSET?

-- YEAR 2014
SELECT
    C.SYMBOL,
    YEAR_OPENEING_PRICE,
    YEAR_CLOSING_PRICE,
    ROUND((YEAR_CLOSING_PRICE - YEAR_OPENEING_PRICE), 4) AS YEAR_2014_RETURNS,
    CASE
        WHEN YEAR_CLOSING_PRICE - YEAR_OPENEING_PRICE > 0 THEN 'PROFITABLE YEAR'
        WHEN YEAR_CLOSING_PRICE - YEAR_OPENEING_PRICE < 0 THEN 'LOSING YEAR'
        ELSE 'BREAK EVEN YEAR'
    END AS YEAR_REMARK
FROM(
    SELECT
        A.SYMBOL,
        COALESCE(CAST(OPEN_PRICE AS FLOAT),0) AS YEAR_OPENEING_PRICE
    FROM SP.Stock_Prices_2014_2017 AS A
    WHERE TRADING_DATE = '2014-01-02'
)A
FULL JOIN (
    SELECT
        C.SYMBOL,
        CAST(CLOSE_PRICE AS FLOAT) AS YEAR_CLOSING_PRICE
    FROM SP.Stock_Prices_2014_2017 AS C
    WHERE TRADING_DATE = '2014-12-31')C
ON A.SYMBOL = C.SYMBOL
ORDER BY C.SYMBOL;

-- YEAR 2015
SELECT
    C.SYMBOL,
    YEAR_OPENEING_PRICE,
    YEAR_CLOSING_PRICE,
    ROUND((YEAR_CLOSING_PRICE - YEAR_OPENEING_PRICE), 4) AS YEAR_2015_RETURNS,
    CASE
        WHEN YEAR_CLOSING_PRICE - YEAR_OPENEING_PRICE > 0 THEN 'PROFITABLE YEAR'
        WHEN YEAR_CLOSING_PRICE - YEAR_OPENEING_PRICE < 0 THEN 'LOSING YEAR'
        ELSE 'BREAK EVEN YEAR'
    END AS YEAR_REMARK
FROM(
    SELECT
        A.SYMBOL,
        COALESCE(CAST(OPEN_PRICE AS FLOAT),0) AS YEAR_OPENEING_PRICE
    FROM SP.Stock_Prices_2014_2017 AS A
    WHERE TRADING_DATE = '2015-01-02'
)A
FULL JOIN (
    SELECT
        C.SYMBOL,
        CAST(CLOSE_PRICE AS FLOAT) AS YEAR_CLOSING_PRICE
    FROM SP.Stock_Prices_2014_2017 AS C
    WHERE TRADING_DATE = '2015-12-31')C
ON A.SYMBOL = C.SYMBOL
ORDER BY C.SYMBOL

-- YEAR 2016
SELECT
    C.SYMBOL,
    YEAR_OPENEING_PRICE,
    YEAR_CLOSING_PRICE,
    ROUND((YEAR_CLOSING_PRICE - YEAR_OPENEING_PRICE), 4) AS YEAR_2016_RETURNS,
    CASE
        WHEN YEAR_CLOSING_PRICE - YEAR_OPENEING_PRICE > 0 THEN 'PROFITABLE YEAR'
        WHEN YEAR_CLOSING_PRICE - YEAR_OPENEING_PRICE < 0 THEN 'LOSING YEAR'
        ELSE 'BREAK EVEN YEAR'
    END AS YEAR_REMARK
FROM(
    SELECT
        A.SYMBOL,
        COALESCE(CAST(OPEN_PRICE AS FLOAT),0) AS YEAR_OPENEING_PRICE
    FROM SP.Stock_Prices_2014_2017 AS A
    WHERE TRADING_DATE = '2016-01-04'
)A
FULL JOIN (
    SELECT
        C.SYMBOL,
        CAST(CLOSE_PRICE AS FLOAT) AS YEAR_CLOSING_PRICE
    FROM SP.Stock_Prices_2014_2017 AS C
    WHERE TRADING_DATE = '2016-12-30')C
ON A.SYMBOL = C.SYMBOL
ORDER BY C.SYMBOL

-- YEAR 2017
SELECT
    C.SYMBOL,
    YEAR_OPENEING_PRICE,
    YEAR_CLOSING_PRICE,
    ROUND((YEAR_CLOSING_PRICE - YEAR_OPENEING_PRICE), 4) AS YEAR_2017_RETURNS,
    CASE
        WHEN YEAR_CLOSING_PRICE - YEAR_OPENEING_PRICE > 0 THEN 'PROFITABLE YEAR'
        WHEN YEAR_CLOSING_PRICE - YEAR_OPENEING_PRICE < 0 THEN 'LOSING YEAR'
        ELSE 'BREAK EVEN YEAR'
    END AS YEAR_REMARK
FROM(
    SELECT
        A.SYMBOL,
        COALESCE(CAST(OPEN_PRICE AS FLOAT),0) AS YEAR_OPENEING_PRICE
    FROM SP.Stock_Prices_2014_2017 AS A
    WHERE TRADING_DATE = '2017-01-03'
)A
FULL JOIN (
    SELECT
        C.SYMBOL,
        (CAST(CLOSE_PRICE AS FLOAT)) AS YEAR_CLOSING_PRICE
    FROM SP.Stock_Prices_2014_2017 AS C
    WHERE TRADING_DATE = '2017-12-29')C
ON A.SYMBOL = C.SYMBOL
ORDER BY C.SYMBOL

-- ACROSS 2014 - 2017 COMBINED
SELECT
    C.SYMBOL,
    YEAR_OPENEING_PRICE,
    YEAR_CLOSING_PRICE,
    ROUND((YEAR_CLOSING_PRICE - YEAR_OPENEING_PRICE), 4) AS YEAR_2014_2017_RETURNS,
    CASE
        WHEN YEAR_CLOSING_PRICE - YEAR_OPENEING_PRICE > 0 THEN 'PROFIT IN 4_YEARS'
        WHEN YEAR_CLOSING_PRICE - YEAR_OPENEING_PRICE < 0 THEN 'LOSS IN 4_YEARS'
        ELSE 'BREAK EVEN IN 4_YEARS'
    END AS _4YEARS_REMARK
FROM(
    SELECT
        A.SYMBOL,
        COALESCE(CAST(OPEN_PRICE AS FLOAT),0) AS YEAR_OPENEING_PRICE
    FROM SP.Stock_Prices_2014_2017 AS A
    WHERE TRADING_DATE = '2014-01-02'
)A
FULL JOIN (
    SELECT
        C.SYMBOL,
        CAST(CLOSE_PRICE AS FLOAT) AS YEAR_CLOSING_PRICE
    FROM SP.Stock_Prices_2014_2017 AS C
    WHERE TRADING_DATE = '2017-12-29')C
ON A.SYMBOL = C.SYMBOL
ORDER BY C.SYMBOL

